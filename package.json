{
  "name": "s3-artifact",
  "version": "1.0.0",
  "description": "Drop-in S3-compatible backend for actions/upload-artifact and actions/download-artifact",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/glob": "^0.7.0",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/lib-storage": "^3.1177.0",
    "archiver": "^8.0.0",
    "minimatch": "^11.0.9",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.19.21",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.0"
  }
}
